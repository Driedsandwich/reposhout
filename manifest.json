{
  "manifest_version": 3,
  "name": "RepoShout — Share GitHub repos, issues & PRs to X",
  "short_name": "RepoShout",
  "version": "1.0.0",
  "description": "Share GitHub repos, issues and PRs to X with a pre-filled post. You press Post on X. Not affiliated with X or GitHub.",
  "homepage_url": "https://github.com/Driedsandwich/reposhout",
  "permissions": ["activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "RepoShout — share this GitHub page to X",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/share.js", "src/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://x.com/*"],
      "js": ["src/esc-close.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "commands": {
    "share-to-x": {
      "suggested_key": {
        "default": "Alt+Shift+X",
        "mac": "Alt+Shift+X"
      },
      "description": "Share the current GitHub page to X"
    }
  }
}
