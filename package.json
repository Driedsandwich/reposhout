{
  "name": "reposhout",
  "version": "1.1.0",
  "private": true,
  "description": "Share GitHub repos, issues and PRs to X with a pre-filled post. Chrome extension, MIT.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test test/share.test.mjs test/esc-close.test.mjs test/manifest.test.mjs",
    "test:e2e": "node --test test/extension.e2e.mjs",
    "package": "node scripts/package.mjs",
    "package:dry": "node scripts/package.mjs --dry-run"
  },
  "dependencies": {},
  "devDependencies": {}
}
